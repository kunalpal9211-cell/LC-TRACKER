# =============================================================
# SPYDEX - DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================

# -------------------------------------------------------------
# 1. BACKEND (RENDER WEB SERVICE) ENVIRONMENT VARIABLES:
# -------------------------------------------------------------
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=spidey-sheet

# Port (Optional on Render - Render provides this automatically)
PORT=5000

# -------------------------------------------------------------
# 2. FRONTEND (VERCEL) ENVIRONMENT VARIABLES:
# -------------------------------------------------------------
# Backend API Base URL (Your live Render Web Service URL)
# Example: https://spydex-api.onrender.com (leave empty for local proxy)
VITE_API_URL=

# Firebase Authentication Credentials (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Setup Checklist:
# 1. Enable "Google" and "Email/Password" in Firebase Authentication -> Sign-in method
# 2. Add your Vercel deployment domain (e.g. your-app.vercel.app) to:
#    Firebase Console -> Authentication -> Settings -> Authorized Domains

